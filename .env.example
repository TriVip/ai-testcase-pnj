# ============================================================
# Environment variable template — placeholders only.
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` file or real secrets to git.
# ============================================================

# ---- MongoDB Configuration ----
# Atlas: mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/testcase-gen
MONGODB_URI=mongodb+srv://<db-username>:<db-password>@<cluster-host>/testcase-gen?retryWrites=true&w=majority

# ---- Server Configuration ----
# 9999 is what the rest of the setup expects: the Vite dev proxy and
# docker-compose both target it. Changing it means changing those too.
PORT=9999
NODE_ENV=development

# ---- JWT Secret ----
# REQUIRED. The server refuses to start without it. It must be at least 32
# characters and must not be one of the known placeholder values — an earlier
# release shipped a default that is public in this repo's history, and anyone
# holding it can forge a token for any account.
# Generate one with: openssl rand -base64 48
# Changing this signs every existing session out.
JWT_SECRET=<generate-a-strong-random-secret>

# ---- Frontend URL ----
# REQUIRED when deploying. This is the only origin CORS and Socket.io accept,
# and the session cookie is SameSite=None, so whatever is set here can make
# authenticated cross-site requests. Point it at the origin actually serving the
# frontend, and update it whenever that changes — a domain you no longer control
# must never be left here. docker-compose refuses to start if it is unset.
# The value below is the local dev origin.
FRONTEND_URL=http://localhost:5173

# ---- Cookie security (optional) ----
# Leave unset. The session cookie defaults to Secure + SameSite=None, which is
# what any deployment behind HTTPS needs. Set to the literal string "false"
# only when testing a deployment reached over plain HTTP with no TLS in front
# of it (e.g. an EC2 public IP directly) — browsers refuse to store a Secure
# cookie over HTTP, so without this, login would return 200 and then look
# logged-out on the next request. Remove it again once HTTPS is in front.
# COOKIE_SECURE=false

# ---- OpenAI Configuration ----
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-3.5-turbo

# ---- Jira Configuration (optional) ----
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=<your-jira-api-token>
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_ISSUE_TYPE=Bug
