# ============================================================
# Environment variable template — placeholders only.
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` file or real secrets to git.
# ============================================================

# ---- MongoDB Configuration ----
# Atlas: mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/testcase-gen
MONGODB_URI=mongodb+srv://<db-username>:<db-password>@<cluster-host>/testcase-gen?retryWrites=true&w=majority

# ---- Server Configuration ----
PORT=5000
NODE_ENV=development

# ---- JWT Secret ----
# REQUIRED. The server refuses to start without it. It must be at least 32
# characters and must not be one of the known placeholder values — an earlier
# release shipped a default that is public in this repo's history, and anyone
# holding it can forge a token for any account.
# Generate one with: openssl rand -base64 48
# Changing this signs every existing session out.
JWT_SECRET=<generate-a-strong-random-secret>

# ---- Frontend URL ----
FRONTEND_URL=http://localhost:5173

# ---- OpenAI Configuration ----
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-3.5-turbo

# ---- Jira Configuration (optional) ----
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=<your-jira-api-token>
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_ISSUE_TYPE=Bug
