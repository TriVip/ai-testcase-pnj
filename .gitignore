# Dependencies
node_modules/
# package-lock.json is committed on purpose. It is what pins transitive
# dependencies to the exact versions that were audited; without it every
# install re-resolves and can silently pull a vulnerable version back in.
yarn.lock
pnpm-lock.yaml

# Environment variables
.env
.env.local
.env.*.local
# .env.example holds placeholders only and is tracked, so a fresh checkout can
# see which variables are required (JWT_SECRET has a minimum strength the server
# enforces at startup).
!.env.example

# Build outputs
dist/
build/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Misc
*.tgz
.npmrc

# Markdown
*.md

.playwright-mcp/